# Copy to .env and fill in real values. Never commit .env.

# SurrealDB (event store + control plane)
SURREAL_USER=root
SURREAL_PASS=change-me
SURREAL_NAMESPACE=studio
SURREAL_DATABASE=studio

# MinIO (S3-compatible object storage for Attachments; swap for R2 credentials in production)
MINIO_ROOT_USER=studio
MINIO_ROOT_PASSWORD=change-me

# Relay (ticket #3): real Workspace/Channel membership lives in SurrealDB,
# projected as NIP-43/NIP-29 events signed by each Workspace's own key.
WORKSPACE_SLUG=family
# Encrypts each Workspace Key at rest (ADR-0002). Generate with e.g.
# `openssl rand -hex 32`; never commit the real value.
WORKSPACE_KEY_SECRET=change-me

# Optional: path to a Firebase service-account JSON file, mounted into the
# container. Leave unset to run without Firebase auth configured — NIP-98
# (Identity-based) auth works either way.
FIREBASE_CREDENTIALS_PATH=
