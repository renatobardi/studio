# Copy to .env and fill in real values. Never commit .env.

# SurrealDB (event store + control plane)
SURREAL_USER=root
SURREAL_PASS=change-me
SURREAL_NAMESPACE=studio
SURREAL_DATABASE=studio

# MinIO (S3-compatible object storage for Attachments; swap for R2 credentials in production)
MINIO_ROOT_USER=studio
MINIO_ROOT_PASSWORD=change-me

# Relay (ticket #2): a single seeded Workspace stands in for real membership
# (ticket #3 replaces this with real Workspace/Channel membership).
WORKSPACE_SLUG=family
WORKSPACE_ALLOWED_PUBKEYS=
