{
  // Everything the build leaves out: the unit tests, the tools CD runs against studio-test, and
  // the Playwright specs. tsconfig.app.json covers only what ships, so without this nothing
  // notices a test rendering a component with props it lacks (#191), and nothing type-checked
  // the seeding that runs in CD with secrets (#238).
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // The .mjs tools are plain JavaScript typed through JSDoc: `allowJs` lets them in, and
    // `checkJs` is what checks them — `allowJs` alone admits a file and checks nothing in it.
    "allowJs": true,
    "checkJs": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "bun"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/lib/testing", "tools", "e2e", "playwright.config.ts"],
  "exclude": []
}
