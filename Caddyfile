{
	auto_https off
	admin off
	servers {
		# In production TLS ends at the host's Nginx (issue #54), which says so
		# in X-Forwarded-Proto. Without trusting it Caddy overwrites the header
		# with its own plain `http`, and the api — whose NIP-98 and NIP-42
		# checks compare signed URLs with the one it was reached on — rejects
		# every call made over https://. Nginx reaches the container from the
		# LXD bridge, a private range.
		trusted_proxies static private_ranges
	}
}

# Plain HTTP inside the container: the network boundary is Tailscale (dev)
# or the host's own Nginx/Certbot in front of this container (prod
# `--public`, per oute-server convention) — Caddy here only routes.
:80 {
	handle /api/* {
		reverse_proxy api:8000
	}

	handle /relay/* {
		reverse_proxy api:8000
	}

	handle /media/* {
		reverse_proxy api:8000
	}

	# The media API's presigned GET redirects here (ticket #6): the bucket name
	# is the S3 path-style prefix, so this must forward the path as-is — no
	# rewriting — or the signature boto3 computed for it won't validate.
	handle /studio-media/* {
		reverse_proxy minio:9000
	}

	handle {
		# nginx-unprivileged (non-root) listens on 8080, not 80 — see web/Dockerfile.
		reverse_proxy web:8080
	}
}
